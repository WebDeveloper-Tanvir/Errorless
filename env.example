# ============================================
# ERRORLESS — Environment Variables
# ============================================

# ── SUPABASE ────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ── GEMINI AI (FREE) ────────────────────────
# Get at: https://aistudio.google.com/app/apikey
# Free: 15 req/min, 1M tokens/day
GEMINI_API_KEY=your_gemini_key_here

# ── RAZORPAY (legacy, no longer used by Dev Mode checkout) ──
# Keep these SECRET, never commit real values.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── AUTH ────────────────────────────────────
NEXTAUTH_SECRET=generate_with_openssl_rand_base64_32
NEXTAUTH_URL=http://localhost:3000
# For production:
# NEXTAUTH_URL=https://v0-errorless.vercel.app

# ── ADMIN (UPI payment verification) ────────
# Comma-separated Clerk user IDs allowed to approve payments at /admin/payments.
# Admins also get Premium for testing. Find your ID in the Clerk dashboard.
ADMIN_USER_IDS=
